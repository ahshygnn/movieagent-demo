YIZHAN_API_KEY=
YIZHAN_BASE_URL=https://vip.yi-zhan.top/v1/
CHARACTER_IMAGE_SIZE=2048x2048
YIZHAN_TTS_MODEL=qwen3-tts-flash
YIZHAN_TTS_DEFAULT_VOICE=Cherry
YIZHAN_TTS_TIMEOUT_SECONDS=120
YIZHAN_TTS_MAX_RETRIES=3
YIZHAN_TTS_MAX_SEGMENT_CHARS=300

ARK_API_KEY=
ENABLE_DUBBING=true
VIDEO_DURATION_SECONDS=5
VIDEO_MAX_CONCURRENCY=2

# 完整功能订阅码；多个码用英文逗号分隔。留空时所有真实生成接口保持锁定。
SUBSCRIPTION_CODES=

# 全局视觉风格：二选一
#   方式一（推荐）：用命名预设，可选 pixar / shinkai / ghibli，留空默认 pixar
VISUAL_STYLE_PRESET=pixar
#   方式二（高级）：直接写自由文本风格描述，一旦设置则覆盖上面的预设
#   示例：Dark gothic oil painting / Flat 2D vector cartoon
# VISUAL_STYLE=
